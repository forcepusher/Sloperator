<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Sloperator.App.ViewModels"
        xmlns:views="using:Sloperator.App.Views"
        x:Class="Sloperator.App.Views.SystemPromptWindow"
        x:DataType="vm:SystemPromptViewModel"
        Title="System prompt"
        Icon="/Assets/sloperator.ico"
        Width="960" Height="733" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner">

  <DockPanel>
    <views:TitleBar DockPanel.Dock="Top" />
    <!-- As Settings' foot: the buttons first, so a narrow window cuts the line short rather than them. -->
    <Border DockPanel.Dock="Bottom" Classes="bar foot">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
          <Button Classes="ghost" Content="Reset to default" Command="{Binding ResetCommand}"
                  ToolTip.Tip="Puts Sloperator's own prompt back, which follows your other settings and new versions" />
          <Button Classes="ghost" Content="Cancel" Click="OnCancel" />
          <Button Classes="primary" Content="Save" Click="OnSave" />
        </StackPanel>
        <TextBlock Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding StatusText}"
                   ToolTip.Tip="{Binding StatusText}" />
      </DockPanel>
    </Border>
    <!-- The prompt in the Code editor's editor, its lines wrapped, its words in braces in yellow. -->
    <views:CodeView x:Name="Editor" WordWrap="True" ShowLineNumbers="False" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12"
                    Background="Transparent" Foreground="{StaticResource BbCode}" Padding="16,8,8,8"
                    HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="System prompt" />
  </DockPanel>
</Window>
